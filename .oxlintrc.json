{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": { "browser": true, "es2022": true },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "smart"],
    "no-unused-vars": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-asserted-optional-chain": "error",

    // Reglas del compilador de React: avisan de patrones que hoy funcionan bien; se revisan sin bloquear
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react/purity": "warn",
    "react/exhaustive-effect-dependencies": "warn",
    "react/memo-dependencies": "warn",

    // Accesibilidad: los desplegables propios usan el patrón ARIA combobox/listbox a propósito
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",

    // Estilo: se ordenan copias recién creadas: sort/reverse no mutan nada compartido
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-underscore-dangle": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"],
      // vitest admite expect(valor, mensaje); los mocks sin tipos y toThrow sin mensaje son normales en los tests
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "vitest/valid-expect": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off"
      }
    },
    {
      "files": ["scripts/**", "pwa/**", "vite.config.ts"],
      "env": { "node": true, "serviceworker": true },
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": ["dist/**", "node_modules/**", "android/**", "scripts/.cache/**"]
}
